---
import { render } from 'astro:content';
import { marked } from 'marked';
import Base from '@/layouts/Base.astro';
import {
  getPosts,
  categoryName,
  categoryUrl,
  tagName,
  tagUrl,
  postUrl,
  formatDate,
  editUrl,
  SITE_TITLE,
} from '@/lib/site';
import { thumbSrcset, thumbUrl } from '@/lib/thumbs';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { category: post.data.categories[0], slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, description, cover, screenshots, downloadLinks, modAuthor, instruction, categories, tags, views } = post.data;

const instructionHtml = instruction ? marked.parse(instruction) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: date.toISOString(),
  ...(description && { description }),
  ...(cover && { image: new URL(cover, Astro.site).href }),
  mainEntityOfPage: new URL(postUrl(post), Astro.site).href,
  publisher: { '@type': 'Organization', name: SITE_TITLE },
};
---

<Base
  title={title}
  description={description}
  canonicalPath={postUrl(post)}
  ogImage={cover}
  ogType="article"
>
  <article>
    <nav class="breadcrumbs muted" aria-label="Хлебные крошки">
      <a href="/">Главная</a>
      <span>/</span>
      <a href={categoryUrl(categories[0])}>{categoryName(categories[0])}</a>
    </nav>

    <h1>{title}</h1>
    <p class="meta muted">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {modAuthor && <span> · Автор мода: <strong>{modAuthor}</strong></span>}
      {views && <span> · {views.toLocaleString('ru-RU')} просмотров</span>}
    </p>

    <div class="prose">
      <Content />
    </div>

    {downloadLinks.length > 0 && (
      <section class="downloads">
        <h2>Скачать</h2>
        <div class="download-btns">
          {downloadLinks.map((link, i) => (
            <a class="btn" href={link} rel="nofollow noopener" target="_blank">
              ⬇ Скачать{downloadLinks.length > 1 ? ` (ссылка ${i + 1})` : ''}
            </a>
          ))}
        </div>
      </section>
    )}

    {instructionHtml && (
      <section class="instruction">
        <h2>Установка</h2>
        <div class="prose" set:html={instructionHtml} />
      </section>
    )}

    {screenshots.length > 0 && (
      <section>
        <h2>Скриншоты</h2>
        <div class="shots">
          {screenshots.map((src) => (
            <a href={src}>
              <img src={thumbUrl(src, 480)} srcset={thumbSrcset(src)} sizes="(max-width: 40rem) calc(100vw - 2rem), 340px" alt={`Скриншот: ${title}`} loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      </section>
    )}

    {tags.length > 0 && (
      <p class="tags">
        {tags.map((t) => <a class="badge" href={tagUrl(t)}>#{tagName(t)}</a>)}
      </p>
    )}

    <p class="edit-link muted">
      Нашли ошибку или хотите дополнить?{' '}
      <a href={editUrl(`posts/${categories[0]}/${post.data.slug}.md`)} rel="noopener">Предложите правку на GitHub</a>
    </p>
  </article>

  <dialog id="lightbox" aria-label="Просмотр скриншота">
    <button class="lb-close" aria-label="Закрыть">✕</button>
    <button class="lb-prev" aria-label="Предыдущий">‹</button>
    <img alt={`Скриншот: ${title}`} />
    <button class="lb-next" aria-label="Следующий">›</button>
  </dialog>

  <script>
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const img = dialog?.querySelector('img');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.shots a')];
    let current = 0;

    function show(i: number) {
      if (!img) return;
      current = (i + links.length) % links.length;
      img.src = links[current].href;
    }

    if (links.length < 2) {
      dialog?.querySelector('.lb-prev')?.setAttribute('hidden', '');
      dialog?.querySelector('.lb-next')?.setAttribute('hidden', '');
    }

    links.forEach((link, i) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog?.showModal();
      });
    });

    dialog?.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('.lb-prev')?.addEventListener('click', () => show(current - 1));
    dialog?.querySelector('.lb-next')?.addEventListener('click', () => show(current + 1));
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close(); // клик по подложке
    });
    dialog?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    margin: 0 0 0.3rem;
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
  }

  .meta {
    margin: 0 0 1.2rem;
  }

  .downloads,
  .instruction {
    margin-top: 1.5rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    max-width: 46rem;
  }

  .downloads h2,
  .instruction h2 {
    margin-top: 0;
    font-size: 1.15rem;
  }

  .download-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.8rem;
    max-width: 46rem;
  }

  .shots img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .edit-link {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    max-width: 46rem;
  }

  #lightbox {
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    max-width: min(90vw, 75rem);
  }

  #lightbox::backdrop {
    background: rgb(0 0 0 / 0.8);
  }

  #lightbox img {
    display: block;
    max-width: 100%;
    max-height: 85vh;
  }

  #lightbox button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 1.3rem;
    cursor: pointer;
  }

  #lightbox button:hover {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .lb-close {
    top: 0.6rem;
    right: 0.6rem;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-prev {
    left: 0.6rem;
  }

  .lb-next {
    right: 0.6rem;
  }
</style>
