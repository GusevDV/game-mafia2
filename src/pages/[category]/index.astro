---
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import {
  getPosts,
  getUsedCategories,
  categoryName,
  categoryUrl,
  POSTS_PER_PAGE,
} from '@/lib/site';

export async function getStaticPaths() {
  const categories = await getUsedCategories();
  return categories.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const posts = (await getPosts()).filter((p) => p.data.categories.includes(category));
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const name = categoryName(category);
---

<Base title={name} description={`${name} для Mafia 2 — все материалы рубрики (${posts.length})`} canonicalPath={categoryUrl(category)}>
  <h1>{name} <span class="muted count">{posts.length}</span></h1>
  <div class="grid">
    {pagePosts.map((post, i) => <PostCard post={post} priority={i < 2} />)}
  </div>
  <Pagination current={1} total={totalPages} urlFor={(p) => categoryUrl(category, p)} />
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .count {
    font-size: 1rem;
    font-weight: 400;
  }
</style>
