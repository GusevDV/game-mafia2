---
import { SITE_TITLE, ADD_MOD_URL } from '@/lib/site';
import Search from './Search.tsx';
---

<header>
  <div class="container top">
    <button class="burger" aria-label="Рубрики" aria-expanded="false" aria-controls="sidebar">
      <span></span><span></span><span></span>
    </button>
    <a class="logo" href="/">
      <span class="logo-mark">M</span>
      <span>{SITE_TITLE}</span>
    </a>
    <Search client:idle />
    <a class="add-mod" href={ADD_MOD_URL} rel="noopener" title="Добавить мод на сайт">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
      <span class="add-mod-label">Добавить мод</span>
    </a>
  </div>
</header>

<script>
  const burger = document.querySelector('.burger');
  burger?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    burger.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.9rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text);
    margin-right: auto;
    white-space: nowrap;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: Georgia, serif;
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 0.28rem;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0.4rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .burger span {
    display: block;
    height: 2px;
    background: var(--text);
    border-radius: 1px;
  }

  /* высота — как у поля поиска (0.95rem текста + отступы 0.5rem + рамка) */
  .add-mod {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex-shrink: 0;
    height: 2.2rem;
    padding: 0 0.95rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .add-mod:hover {
    background: var(--accent-strong);
    color: var(--accent-contrast);
    text-decoration: none;
  }

  .add-mod:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .add-mod svg {
    flex-shrink: 0;
  }

  @media (max-width: 60rem) {
    .burger {
      display: flex;
      flex-shrink: 0;
    }
  }

  /* на телефоне остаётся квадрат с «+», подпись видна лишь скринридерам */
  @media (max-width: 40rem) {
    .top {
      gap: 0.6rem;
    }

    .add-mod {
      width: 2.2rem;
      padding: 0;
    }

    .add-mod-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
