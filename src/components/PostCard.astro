---
import { categoryName, categoryUrl, formatDate, postUrl, type Post } from '@/lib/site';
import { thumbSrcset, thumbUrl } from '@/lib/thumbs';

interface Props {
  post: Post;
  /** Картинка в первом экране: грузится сразу и с высоким приоритетом (LCP). */
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const { title, date, cover, categories, views } = post.data;
---

<article class="card">
  <div class="cover">
    {cover ? (
      <img
        src={thumbUrl(cover, 480)}
        srcset={thumbSrcset(cover)}
        sizes="(max-width: 40rem) calc(100vw - 2rem), 340px"
        width="480"
        height="270"
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <span class="cover-placeholder">M</span>
    )}
  </div>
  <div class="body">
    <a class="badge" href={categoryUrl(categories[0])}>{categoryName(categories[0])}</a>
    <h3><a href={postUrl(post)}>{title}</a></h3>
    <p class="muted meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {views ? <span> · {views.toLocaleString('ru-RU')} просм.</span> : null}
    </p>
  </div>
</article>

<style>
  .card {
    position: relative; /* anchor for the stretched title link below */
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: var(--accent);
  }

  /* keyboard focus is shown on the whole card, not just around the title text */
  .card:has(h3 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--bg-overlay);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: Georgia, serif;
    font-size: 3rem;
    color: var(--border);
  }

  .body {
    padding: 0.9rem 1rem 1rem;
  }

  h3 {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.05rem;
  }

  h3 a {
    color: var(--text);
  }

  .card:hover h3 a {
    color: var(--accent);
  }

  h3 a:focus-visible {
    outline: none;
  }

  /* Stretched link: the title link covers the whole card, so the cover, the date
     and the padding are clickable too. Keep exactly one link to the post per card. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* the category badge stays a separate link above the overlay */
  .badge {
    position: relative;
    z-index: 1;
  }

  .meta {
    margin: 0;
    font-size: 0.85rem;
  }
</style>
